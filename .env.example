# Copy to .env and adjust. No real credentials belong in this file.
# All values are optional; defaults work out of the box (fallback mode).

# ---- LLM mode -------------------------------------------------------------
# auto     : use Ollama if it is reachable AND the model is installed, else fallback
# ollama   : require Ollama (falls back per-request if the call fails)
# openai_compatible : any OpenAI-style /v1/chat/completions endpoint (optional)
# fallback : never call an LLM (deterministic rules only)
LLM_PROVIDER=auto
LLM_TIMEOUT_SECONDS=30

# Ollama (local, no API key)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Optional OpenAI-compatible provider (leave blank unless you use it)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_MODEL=
OPENAI_COMPAT_API_KEY=

# Let the LLM add a short natural-language rephrasing of tool results.
# The deterministic, tool-backed answer is always shown regardless.
LLM_FORMULATE_RESPONSES=false

# ---- Database -------------------------------------------------------------
AGENTBANK_DB_PATH=var/agentbank.db

# ---- Fraud engine thresholds (rule-based, 0-100 score: LOW < medium <= MEDIUM < high <= HIGH) ----------------------
RISK_THRESHOLD_MEDIUM=30
RISK_THRESHOLD_HIGH=60

# ---- Loan engine thresholds (illustrative, not a lending policy) ------------
LOAN_ASSUMED_ANNUAL_RATE=0.11
LOAN_ASSUMED_TENURE_MONTHS=36
LOAN_MIN_CREDIT_SCORE=650
LOAN_REFER_CREDIT_SCORE=600
LOAN_MAX_DTI=0.40
LOAN_REFER_DTI=0.50
LOAN_MIN_EMPLOYMENT_YEARS=1.0
LOAN_MAX_MULTIPLE_OF_ANNUAL_INCOME=2.0
LOAN_MIN_AMOUNT=10000
LOAN_MAX_AMOUNT=5000000
